# --- Sovereign Swarm Executor (apps/api/worker) ---
FROM python:3.12-slim-bookworm

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1
ENV NODE_VERSION=22.x
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    procps \
    curl \
    gnupg \
    build-essential \
    ffmpeg \
    libpq-dev \
    git \
    adb \
    iproute2 \
    libgl1 \
    libglib2.0-0 \
    wget \
    ca-certificates \
    fonts-ipafont-gothic \
    fonts-wqy-zenhei \
    fonts-thai-tlwg \
    fonts-kacst \
    fonts-freefont-ttf \
    && wget -q https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
    && apt-get install -y ./google-chrome-stable_current_amd64.deb \
    && rm google-chrome-stable_current_amd64.deb \
    && rm -rf /var/lib/apt/lists/*

# [SOVEREIGN] Browser Path
ENV CHROME_PATH=/usr/bin/google-chrome

# Install Node.js & pnpm
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION} | bash - \
    && apt-get install -y nodejs \
    && npm install -g pnpm

# Install Playwright dependencies (required for browser automation)
RUN npx playwright install-deps

# [OPTIMIZED] Ensure pip is up to date and resilient
RUN pip install --no-cache-dir --upgrade pip

# [OPTIMIZED] Dedicated layer for heavy AI packages (Resilient install)
RUN pip install --no-cache-dir --retries 20 --default-timeout=2000 \
    torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu

# [OPTIMIZED] Step 1: Heavy Infrastructure & Data packages
RUN pip install --no-cache-dir --retries 30 --default-timeout=3000 \
    pyarrow onnxruntime opencv-python faster-whisper lancedb numpy

# [OPTIMIZED] Step 2: Everything else from requirements
COPY apps/api/requirements_sovereign.txt .
RUN pip install --no-cache-dir --retries 30 --default-timeout=3000 -r requirements_sovereign.txt

WORKDIR /app
ENV PYTHONPATH=/app

# Copy all source code
COPY . .

# Run Worker (Muscle Hub)
CMD ["python", "scripts/worker.py"]
